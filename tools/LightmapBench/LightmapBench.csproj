<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CPU benchmark and bit-exactness check for the Android mobile lightmap
    (Clyde.MobileLighting.cs in android/patches/robust-android-v295.patch).
    The optimized code is not copied here: the block between the
    "mobile-lightmap-cpu-core" markers is extracted from the patch on every build,
    so the benchmark always measures what ships. Baseline.cs is the frozen
    implementation from Android 0.9.1.

      dotnet run -c Release (project tools/LightmapBench)          verify + benchmark
      dotnet run -c Release (project tools/LightmapBench) verify   only the bit-exactness check
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);CS0414;CS0169</NoWarn>
    <EnginePatch>$(MSBuildThisFileDirectory)..\..\android\patches\robust-android-v295.patch</EnginePatch>
  </PropertyGroup>

  <UsingTask TaskName="ExtractMobileLightmapCore" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Patch ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string Begin = "// mobile-lightmap-cpu-core: begin";
        const string End = "// mobile-lightmap-cpu-core: end";
        var lines = File.ReadAllLines(Patch);
        var sb = new StringBuilder();
        sb.AppendLine("// <auto-generated> extracted from android/patches/robust-android-v295.patch </auto-generated>");
        sb.AppendLine("#nullable enable");
        sb.AppendLine("using System;");
        sb.AppendLine("using System.Collections.Generic;");
        sb.AppendLine("using System.Numerics;");
        sb.AppendLine("namespace LightmapBench;");
        sb.AppendLine("internal sealed partial class OptimizedLightmap");
        sb.AppendLine("{");
        var inside = false;
        var found = false;
        foreach (var raw in lines)
        {
            var line = raw.TrimEnd('\r');
            if (line.EndsWith(Begin)) { inside = true; found = true; continue; }
            if (line.EndsWith(End)) { inside = false; continue; }
            if (!inside) continue;
            if (!line.StartsWith("+"))
            {
                Log.LogError("Unexpected non-added line inside the lightmap core block: " + line);
                return false;
            }
            sb.AppendLine(line.Substring(1));
        }
        if (!found || inside)
        {
            Log.LogError("mobile-lightmap-cpu-core markers not found in " + Patch);
            return false;
        }
        sb.AppendLine("}");
        var text = sb.ToString();
        if (!File.Exists(Output) || File.ReadAllText(Output) != text)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(Output));
            File.WriteAllText(Output, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="IncludeMobileLightmapCore" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <LightmapCoreFile>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)MobileLightmapCore.g.cs</LightmapCoreFile>
    </PropertyGroup>
    <ExtractMobileLightmapCore Patch="$(EnginePatch)" Output="$(LightmapCoreFile)" />
    <ItemGroup>
      <Compile Include="$(LightmapCoreFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <UpToDateCheckInput Include="$(EnginePatch)" />
  </ItemGroup>

</Project>
