<Project TreatAsLocalProperty="OutputType">
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>ru.ministation.client</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.3.1</ApplicationDisplayVersion>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>NU1701;CA1416</NoWarn>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>None</TrimMode>
    <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>
    <!-- AOT is slow and not needed for the first runnable APK; turn on later if perf demands it. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <UseInterpreter>false</UseInterpreter>
    <RuntimeIdentifiers>android-x64;android-arm64</RuntimeIdentifiers>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <ExcludeSatelliteAssemblies>true</ExcludeSatelliteAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- TargetOS must be forced: otherwise the net10.0 engine projects compile the FREEDESKTOP branches. -->
    <ProjectReference Include="../../vendor/RobustToolbox/Robust.Client/Robust.Client.csproj">
      <ExcludeAssets>native</ExcludeAssets>
      <AdditionalProperties>TargetOS=Android</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../../vendor/RobustToolbox/Robust.Shared/Robust.Shared.csproj">
      <ExcludeAssets>native</ExcludeAssets>
      <AdditionalProperties>TargetOS=Android</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.629.0">
      <Aliases>ppysdl</Aliases>
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="MonoGame.Library.OpenAL" Version="1.24.3.4">
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SharpZstd.Interop" Version="1.5.2-beta2">
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SpaceWizards.Sodium" Version="0.3.0">
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="libsodium" Version="1.0.20.1">
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <UseSystemSqlite>True</UseSystemSqlite>
  </PropertyGroup>

  <!-- Permanent test key so Release APKs install over each other. Replace for production. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and Exists('$(MSBuildProjectDirectory)/keystore/test.keystore')">
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildProjectDirectory)/keystore/test.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>ministation</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>ministation</AndroidSigningKeyPass>
    <AndroidSigningStorePass>ministation</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <AndroidNativeLibrary Include="lib\arm64-v8a\*.so" />
    <AndroidNativeLibrary Include="lib\x86_64\*.so" />
  </ItemGroup>

  <ItemGroup>
    <!-- Engine-only boot resources (robust-295/Resources). Content resources come from the downloaded SS14.Client.zip. -->
    <EmbeddedResource Include="engine-resources.zip" />
    <EmbeddedResource Include="logo-long.png" />
  </ItemGroup>

  <ItemGroup>
    <AndroidEnvironment Include="environment.txt" />
  </ItemGroup>

  <!-- Drop native libs shipped by NuGet packages; we ship our own per-ABI builds in lib/. -->
  <Target Name="RemoveNuGetConflictLibs" BeforeTargets="ResolveAssemblyReferences;ResolvePackageAssets;_CreateAssemblyStore;_BuildApkEmbed;_ProcessNativeLibraries">
    <ItemGroup>
      <AndroidNativeLibrary Remove="@(AndroidNativeLibrary)" Condition="('%(FileName)' == 'libsodium' or '%(FileName)' == 'libzstd' or '%(FileName)' == 'libopenal' or '%(FileName)' == 'libfreetype' or '%(FileName)' == 'libSDL3' or '%(FileName)' == 'SDL3') and !$([System.String]::new('%(FullPath)').Contains('$(MSBuildProjectDirectory)'))" />
      <None Remove="@(None)" Condition="('%(FileName)' == 'libsodium' or '%(FileName)' == 'libzstd' or '%(FileName)' == 'libopenal' or '%(FileName)' == 'libfreetype' or '%(FileName)' == 'libSDL3' or '%(FileName)' == 'SDL3') and !$([System.String]::new('%(FullPath)').Contains('$(MSBuildProjectDirectory)'))" />
      <Content Remove="@(Content)" Condition="('%(FileName)' == 'libsodium' or '%(FileName)' == 'libzstd' or '%(FileName)' == 'libopenal' or '%(FileName)' == 'libfreetype' or '%(FileName)' == 'libSDL3' or '%(FileName)' == 'SDL3') and !$([System.String]::new('%(FullPath)').Contains('$(MSBuildProjectDirectory)'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="('%(FileName)' == 'libsodium' or '%(FileName)' == 'libzstd' or '%(FileName)' == 'libopenal' or '%(FileName)' == 'libfreetype' or '%(FileName)' == 'libSDL3' or '%(FileName)' == 'SDL3') and !$([System.String]::new('%(FullPath)').Contains('$(MSBuildProjectDirectory)'))" />
    </ItemGroup>
  </Target>
  <Target Name="FilterSatelliteAssemblies" BeforeTargets="_BuildApkEmbed;_CreateAssemblyStore;_BuildApk;CreateAssemblyStore;WrapAssembliesAsSharedLibraries">
    <ItemGroup>
      <_BuildApkResolvedUserAssemblies Remove="@(_BuildApkResolvedUserAssemblies)" Condition="$([System.String]::new('%(FullPath)').Contains('.resources.'))" />
      <_BuildApkResolvedFrameworkAssemblies Remove="@(_BuildApkResolvedFrameworkAssemblies)" Condition="$([System.String]::new('%(FullPath)').Contains('.resources.'))" />
      <ResolvedUserAssemblies Remove="@(ResolvedUserAssemblies)" Condition="$([System.String]::new('%(FullPath)').Contains('.resources.'))" />
      <ResolvedFrameworkAssemblies Remove="@(ResolvedFrameworkAssemblies)" Condition="$([System.String]::new('%(FullPath)').Contains('.resources.'))" />
      <_BuildApkAssembliesToAddToArchive Remove="@(_BuildApkAssembliesToAddToArchive)" Condition="$([System.String]::new('%(FullPath)').Contains('.resources.'))" />
      <ReferenceSatellitePaths Remove="@(ReferenceSatellitePaths)" />
      <IntermediateSatelliteAssembliesWithTargetPath Remove="@(IntermediateSatelliteAssembliesWithTargetPath)" />
    </ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="CustomTargets.targets" />
  <PropertyGroup>
    <_AndroidXA1030>false</_AndroidXA1030>
  </PropertyGroup>
</Project>
