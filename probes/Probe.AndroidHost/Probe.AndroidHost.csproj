<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>org.ss14.mobilehub</ApplicationId>
    <ApplicationVersion>308</ApplicationVersion>
    <ApplicationDisplayVersion>0.3.8</ApplicationDisplayVersion>
    <ApplicationTitle>SS14 Hub</ApplicationTitle>
    <TrimMode>partial</TrimMode>
    <!-- AOT + aggressive trim strips NetSerializable types → serializer bootstrap fails. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidEnableMarshalMethods>true</AndroidEnableMarshalMethods>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <!-- Keep Java/IL trim conservative — content serializers need reflection. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Robust.Shared" RootMode="All" />
    <TrimmerRootAssembly Include="Robust.Shared.Maths" RootMode="All" />
    <TrimmerRootAssembly Include="Robust.Client" RootMode="All" />
    <TrimmerRootAssembly Include="Robust.Server" RootMode="All" />
    <TrimmerRootAssembly Include="Port.Net" RootMode="All" />
    <TrimmerRootAssembly Include="Port.Content" RootMode="All" />
    <TrimmerRootAssembly Include="Port.Client" RootMode="All" />
    <TrimmerRootAssembly Include="Robust.NetSerializer" RootMode="All" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Probe.SharedOnAndroid\Probe.SharedOnAndroid.csproj" />
    <ProjectReference Include="..\..\src\Port.Platform.Android\Port.Platform.Android.csproj" />
    <ProjectReference Include="..\..\src\Port.Client\Port.Client.csproj" />
    <ProjectReference Include="..\..\src\Port.Net\Port.Net.csproj" />
    <ProjectReference Include="..\..\src\Port.Content\Port.Content.csproj" />
  </ItemGroup>

  <!-- Ship libsodium for CryptoBox / AEAD (NuGet android RIDs + explicit ABI pack). -->
  <!-- Ship libzstd for SharpZstd / mapped strings / MsgState (from com.github.luben:zstd-jni 1.5.6-9). -->
  <ItemGroup>
    <AndroidNativeLibrary Include="lib\arm64-v8a\libsodium.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib\x86_64\libsodium.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib\armeabi-v7a\libsodium.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib\x86\libsodium.so">
      <Abi>x86</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib\arm64-v8a\libzstd.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib\x86_64\libzstd.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib\armeabi-v7a\libzstd.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="lib\x86\libzstd.so">
      <Abi>x86</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!-- Drop desktop linux/osx/win natives that Shared pulls transitively. -->
  <Target Name="StripNonAndroidNatives" BeforeTargets="_CreateBaseApkWithArtProfile;_BuildApkFastDev;_CompileJava">
    <ItemGroup>
      <AndroidNativeLibrary Remove="@(AndroidNativeLibrary)" Condition="$([System.String]::Copy('%(Identity)').Contains('linux-x64')) Or $([System.String]::Copy('%(Identity)').Contains('linux-arm64')) Or $([System.String]::Copy('%(Identity)').Contains('osx-')) Or $([System.String]::Copy('%(Identity)').Contains('win-')) Or $([System.String]::Copy('%(Identity)').Contains('ios-')) Or $([System.String]::Copy('%(Identity)').Contains('maccatalyst')) Or $([System.String]::Copy('%(Identity)').Contains('tvos-'))" />
      <NativeSystemLibrary Remove="@(NativeSystemLibrary)" Condition="$([System.String]::Copy('%(Identity)').Contains('linux-x64'))" />
    </ItemGroup>
  </Target>
</Project>
