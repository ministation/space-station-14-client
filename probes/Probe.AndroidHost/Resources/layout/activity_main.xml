<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hub_bg">

    <!-- ===== HUB ===== -->
    <ScrollView
        android:id="@+id/screen_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@color/hub_panel">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ss14_logo_site"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hub_title"
                        android:textColor="@color/hub_text"
                        android:textSize="12sp"
                        android:fontFamily="@font/pressstart2p" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hub_subtitle"
                        android:textColor="@color/hub_beige"
                        android:textSize="11sp"
                        android:fontFamily="@font/exo2_regular" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/hub_beige" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/beta_banner"
                    android:textColor="@color/hub_beige_dim"
                    android:textSize="10sp"
                    android:fontFamily="@font/pressstart2p"
                    android:gravity="center"
                    android:paddingBottom="12dp" />

                <!-- Account -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/hub_card"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/auth_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hub_muted"
                        android:textSize="13sp"
                        android:fontFamily="@font/exo2_regular"
                        android:text="Войдите через аккаунт SS14" />

                    <LinearLayout
                        android:id="@+id/auth_login_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/auth_username"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:hint="@string/auth_username_hint"
                            android:inputType="text"
                            android:textColor="@color/hub_text"
                            android:textColorHint="@color/hub_muted"
                            android:background="@drawable/hub_input"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="14sp"
                            android:fontFamily="@font/exo2_regular" />

                        <EditText
                            android:id="@+id/auth_password"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:hint="@string/auth_password_hint"
                            android:inputType="textPassword"
                            android:textColor="@color/hub_text"
                            android:textColorHint="@color/hub_muted"
                            android:background="@drawable/hub_input"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="14sp"
                            android:fontFamily="@font/exo2_regular" />

                        <EditText
                            android:id="@+id/auth_tfa"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:hint="@string/auth_tfa_hint"
                            android:inputType="number"
                            android:textColor="@color/hub_text"
                            android:textColorHint="@color/hub_muted"
                            android:background="@drawable/hub_input"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="14sp"
                            android:fontFamily="@font/exo2_regular" />

                        <Button
                            android:id="@+id/btn_login_ss14"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/hub_btn"
                            android:textColor="@color/hub_text"
                            android:text="@string/btn_login_ss14"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:fontFamily="@font/exo2_semibold"
                            android:stateListAnimator="@null" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_logout_ss14"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/hub_btn_danger"
                        android:textColor="@color/hub_text"
                        android:text="@string/btn_logout_ss14"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:fontFamily="@font/exo2_semibold"
                        android:stateListAnimator="@null"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Servers / Hub (collapsed by default) -->
                <LinearLayout
                    android:id="@+id/hub_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/hub_card"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/hub_header_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/servers_title"
                        android:textColor="@color/hub_beige"
                        android:textSize="11sp"
                        android:fontFamily="@font/pressstart2p" />

                    <TextView
                        android:id="@+id/hub_header_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textColor="@color/hub_beige"
                        android:textSize="14sp"
                        android:paddingEnd="8dp" />

                    <Button
                        android:id="@+id/btn_refresh_hub"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/hub_input"
                        android:textColor="@color/hub_beige"
                        android:text="@string/btn_refresh_servers"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:fontFamily="@font/exo2_semibold"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hub_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/hub_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/hub_muted"
                        android:textSize="11sp"
                        android:fontFamily="@font/exo2_regular"
                        android:text="Хабы свёрнуты — нажмите, чтобы открыть" />

                    <EditText
                        android:id="@+id/hub_search"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:hint="@string/hub_search_hint"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:textColor="@color/hub_text"
                        android:textColorHint="@color/hub_muted"
                        android:background="@drawable/hub_input"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="14sp"
                        android:fontFamily="@font/exo2_regular" />

                    <LinearLayout
                        android:id="@+id/server_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/custom_server"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="@string/custom_server_hint"
                        android:inputType="textUri"
                        android:textColor="@color/hub_text"
                        android:textColorHint="@color/hub_muted"
                        android:background="@drawable/hub_input"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <Button
                        android:id="@+id/btn_add_server"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/hub_btn"
                        android:textColor="@color/hub_text"
                        android:text="@string/btn_add_server"
                        android:textAllCaps="false"
                        android:fontFamily="@font/exo2_semibold"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/server_chip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/hub_beige"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:text="—" />

                <TextView
                    android:id="@+id/status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/server_players_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/connect_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/hub_muted"
                    android:textSize="13sp"
                    android:fontFamily="@font/exo2_regular"
                    android:text="Выберите сервер" />

                <TextView
                    android:id="@+id/download_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Контент"
                    android:textColor="@color/hub_beige"
                    android:textSize="10sp"
                    android:fontFamily="@font/pressstart2p"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/download_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/hub_beige"
                    android:progressBackgroundTint="@color/hub_panel2"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/download_pct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/hub_beige"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    android:text="0%" />

                <Button
                    android:id="@+id/btn_connect"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/hub_btn"
                    android:textColor="@color/hub_text"
                    android:text="@string/btn_connect"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:fontFamily="@font/pressstart2p"
                    android:stateListAnimator="@null" />

                <TextView
                    android:id="@+id/debug_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="12dp"
                    android:background="@drawable/hub_card"
                    android:text="@string/debug_toggle"
                    android:textColor="@color/hub_muted"
                    android:textSize="10sp"
                    android:fontFamily="@font/pressstart2p"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/join_debug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="80dp"
                    android:background="@color/hub_bg_deep"
                    android:padding="10dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/hub_beige"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:text="…" />

                <TextView
                    android:id="@+id/home_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textColor="@color/hub_muted"
                    android:textSize="11sp"
                    android:fontFamily="@font/exo2_regular"
                    android:text="SS14 Hub · public beta" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== LOBBY (PC-like) ===== -->
    <LinearLayout
        android:id="@+id/screen_lobby"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/hub_bg_deep">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@color/hub_panel">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="24dp"
                android:src="@drawable/ss14_logo_site"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lobby_station"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Station"
                    android:textColor="@color/hub_text"
                    android:textSize="13sp"
                    android:fontFamily="@font/pressstart2p"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/lobby_round"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="In Lobby"
                    android:textColor="@color/hub_ok"
                    android:textSize="12sp"
                    android:fontFamily="@font/exo2_semibold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/hub_btn_danger"
                android:textColor="@color/hub_text"
                android:text="@string/btn_disconnect"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:fontFamily="@font/exo2_semibold"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/hub_beige" />

        <!-- Body: character | players -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="10dp">

            <!-- Left: character -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.95"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/hub_card"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ПЕРСОНАЖ"
                        android:textColor="@color/hub_beige"
                        android:textSize="10sp"
                        android:fontFamily="@font/pressstart2p" />

                    <TextView
                        android:id="@+id/lobby_account"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/hub_muted"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <EditText
                        android:id="@+id/char_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:hint="@string/char_name_hint"
                        android:inputType="textPersonName"
                        android:textColor="@color/hub_text"
                        android:textColorHint="@color/hub_muted"
                        android:background="@drawable/hub_input"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:fontFamily="@font/exo2_regular" />

                    <TextView
                        android:id="@+id/lobby_char_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Статус: Not Ready"
                        android:textColor="@color/hub_beige"
                        android:textSize="13sp"
                        android:fontFamily="@font/exo2_semibold" />

                    <TextView
                        android:id="@+id/lobby_content_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/hub_muted"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:text="content: …" />
                </LinearLayout>
            </ScrollView>

            <!-- Right: player list -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:background="@drawable/hub_card"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/players_title"
                        android:textColor="@color/hub_beige"
                        android:textSize="10sp"
                        android:fontFamily="@font/pressstart2p" />

                    <TextView
                        android:id="@+id/lobby_player_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/hub_text"
                        android:textSize="12sp"
                        android:fontFamily="@font/exo2_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:text="Имя"
                        android:textColor="@color/hub_muted"
                        android:textSize="11sp"
                        android:fontFamily="@font/exo2_regular" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Статус"
                        android:textColor="@color/hub_muted"
                        android:textSize="11sp"
                        android:fontFamily="@font/exo2_regular" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hub_btn" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/lobby_players"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/hub_text"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp"
                        android:text="…" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- Always-visible actions (cannot be scrolled away) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="@color/hub_panel"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_ready"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/hub_btn"
                android:textColor="@color/hub_text"
                android:text="@string/btn_ready"
                android:textAllCaps="false"
                android:fontFamily="@font/pressstart2p"
                android:textSize="11sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_observe"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.15"
                android:layout_marginStart="8dp"
                android:background="@drawable/hub_btn"
                android:textColor="@color/hub_text"
                android:text="@string/btn_observe"
                android:textAllCaps="false"
                android:fontFamily="@font/pressstart2p"
                android:textSize="11sp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/lobby_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:textColor="@color/hub_muted"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- ===== OBSERVE / GAME (landscape) ===== -->
    <LinearLayout
        android:id="@+id/screen_observe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="@color/hub_bg_deep">

        <!-- Left touch zone -->
        <LinearLayout
            android:id="@+id/touch_pad_left"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/hub_panel"
            android:padding="6dp">

            <Button
                android:id="@+id/btn_touch_up"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/hub_btn"
                android:text="▲"
                android:textColor="@color/hub_text"
                android:textSize="18sp"
                android:stateListAnimator="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btn_touch_left"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/hub_btn"
                    android:text="◀"
                    android:textColor="@color/hub_text"
                    android:textSize="18sp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_touch_down"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/hub_btn"
                android:text="▼"
                android:textColor="@color/hub_text"
                android:textSize="18sp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:background="@color/hub_panel">

                <TextView
                    android:id="@+id/observe_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VIEWPORT"
                    android:textColor="@color/hub_beige"
                    android:textSize="11sp"
                    android:fontFamily="@font/pressstart2p" />

                <Button
                    android:id="@+id/btn_observe_leave"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/hub_btn"
                    android:textColor="@color/hub_text"
                    android:text="@string/btn_disconnect"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:fontFamily="@font/exo2_semibold"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/observe_gl"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#000000">

    <TextView 
                    android:id="@+id/observe_crosshair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textColor="#66FFFFFF"
                    android:textSize="28sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/observe_hud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:background="@color/hub_panel"
                android:fontFamily="monospace"
                android:textColor="@color/hub_text"
                android:textSize="10sp"
                android:text="@string/touch_hint" />
        </LinearLayout>

        <!-- Right touch zone -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/hub_panel"
            android:padding="6dp">

            <Button
                android:id="@+id/btn_touch_right"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/hub_btn"
                android:text="▶"
                android:textColor="@color/hub_text"
                android:textSize="18sp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
