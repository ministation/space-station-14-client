<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal progress in launcher palette: dark track, control-mid fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/la_stripe_a" />
            <stroke android:width="1dp" android:color="@color/la_ctrl_mid" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/la_ctrl_mid" />
            </shape>
        </clip>
    </item>
</layer-list>
