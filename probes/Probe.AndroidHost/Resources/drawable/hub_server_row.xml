<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hub_btn_pressed" />
            <stroke android:width="1dp" android:color="@color/hub_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/hub_panel2"
                android:endColor="@color/hub_panel" />
            <stroke android:width="1dp" android:color="#66525A66" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
