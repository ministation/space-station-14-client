<?xml version="1.0" encoding="utf-8"?>
<!-- SS14.Launcher TextBox: popup background + border + corner wings. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/la_popup" />
            <stroke android:width="1dp" android:color="@color/la_ctrl_mid" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/la_wing_tr"
        android:gravity="top|right"
        android:width="14dp"
        android:height="10dp" />
    <item
        android:drawable="@drawable/la_wing_bl"
        android:gravity="bottom|left"
        android:width="14dp"
        android:height="10dp" />
</layer-list>
